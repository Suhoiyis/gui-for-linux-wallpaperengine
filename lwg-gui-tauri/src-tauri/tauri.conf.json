{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Wallpaper Engine GUI",
  "version": "0.1.0",
  "identifier": "com.wallpaperengine.gui",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,

    "windows": [
      {
        "title": "Wallpaper Engine",
        "width": 1280,
        "height": 800,
        "resizable": true,
        "fullscreen": false,
        "visible": false
      }
    ],

    "security": {
      "csp": "default-src 'self'; img-src * asset: http://asset.localhost blob: data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline' 'unsafe-eval';",

      "assetProtocol": {
        "enable": true,
        "scope": ["**", "/home/**", "/home/yua/.local/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
